<Window x:Class="WszSearcher.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 WszSearcher"
        Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：图标 + 名称 + 版本 -->
        <StackPanel Grid.Row="0">
            <Image Source="/Resources/app.ico" Width="56" Height="56"
                   HorizontalAlignment="Center" Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="WszSearcher"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="v1.0.0"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />

            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,16,0,16" />
        </StackPanel>

        <!-- 中间：描述 + 技术栈（带滚动条） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 项目简介 -->
                <TextBlock Text="项目简介" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="22">
WszSearcher 是一款 Windows 极速文件搜索工具，基于 NTFS USN Journal 实现毫秒级文件名匹配，配合 Lucene.NET 全文索引和结巴中文分词实现高效的内容搜索。支持 Alt+Space 全局热键快速唤起，搜索结果实时预览，深色/浅色主题一键切换。
                </TextBlock>

                <!-- 技术栈 -->
                <TextBlock Text="技术栈" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,20,0,8" />

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <!-- 每一项技术栈 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="C# .NET 10 + WPF"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="桌面应用框架" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Lucene.NET 3.0.3"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="全文检索引擎" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="jieba.NET" Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="中文分词" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="PdfPig" Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="PDF 文档解析" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="DocumentFormat.OpenXml"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Office 文档解析" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Hardcodet.NotifyIcon.Wpf"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="系统托盘" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="CommunityToolkit.Mvvm"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="MVVM 架构" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 许可信息 -->
                <TextBlock Text="许可" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,20,0,8" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="20"
                           Margin="0,0,0,16">
© 2026 wszhoho. MIT License. 本软件按"原样"提供，不提供任何形式的明示或暗示担保。
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Margin="0,0,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Content="确定" IsDefault="True"
                    Width="100" Height="32" FontSize="13"
                    HorizontalAlignment="Center"
                    Click="OnCloseClick"
                    Background="#0078D4" Foreground="White"
                    BorderBrush="#0078D4" BorderThickness="1"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>
