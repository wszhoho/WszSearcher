<Window x:Class="WszSearcher.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lang.About.Title}"
        Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：图标 + 名称 + 版本 -->
        <StackPanel Grid.Row="0">
            <Image Source="/Resources/app.ico" Width="56" Height="56"
                   HorizontalAlignment="Center" Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="WszSearcher"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />

            <Border Height="1" Background="{DynamicResource BorderBrush}"
                    Margin="0,16,0,16" />
        </StackPanel>

        <!-- 中间：描述 + 技术栈（带滚动条） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 项目简介 -->
                <TextBlock Text="{DynamicResource Lang.About.ProjectIntro}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />
                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="22"
                           Text="{DynamicResource Lang.About.Description}" />

                <!-- 技术栈 -->
                <TextBlock Text="{DynamicResource Lang.About.TechStack}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,20,0,8" />

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <!-- 每一项技术栈 -->
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="C# .NET 10 + WPF"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechDesktop}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Win32 USN Journal API"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechUsn}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Lucene.NET 3.0.3"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechLucene}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="jieba.NET"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechJieba}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="ToolGood.Words"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechPinyin}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="PdfPig"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechPdf}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="DocumentFormat.OpenXml"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechOffice}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Hardcodet.NotifyIcon.Wpf"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechTray}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="CommunityToolkit.Mvvm"
                                       Width="180" FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Lang.About.TechMvvm}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 许可信息 -->
                <TextBlock Text="{DynamicResource Lang.About.License}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,20,0,8" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="20"
                           Margin="0,0,0,16"
                           Text="{DynamicResource Lang.About.LicenseText}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Margin="0,0,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Content="{DynamicResource Lang.About.OK}" IsDefault="True"
                    Width="100" Height="32" FontSize="13"
                    HorizontalAlignment="Center"
                    Click="OnCloseClick"
                    Background="#0078D4" Foreground="White"
                    BorderBrush="#0078D4" BorderThickness="1"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>
