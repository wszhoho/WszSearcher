<Window x:Class="WszSearcher.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览"
        Width="360" Height="480"
        MinWidth="280" MinHeight="200"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding PreviewContent.Title}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PreviewContent.FilePath}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="28" Height="24" Click="OnCopyContent"
                            Background="Transparent" BorderThickness="0"
                            FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand" Content="📋" ToolTip="复制全文" />
                    <Button Width="28" Height="24" Click="OnPrevMatch"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand" Content="▲" ToolTip="上一个" />
                    <TextBlock x:Name="MatchLabel" Text="" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="4,0" />
                    <Button Width="28" Height="24" Click="OnNextMatch"
                            Background="Transparent" BorderThickness="0"
                            FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand" Content="▼" ToolTip="下一个" />
                    <Button Width="24" Height="24" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Command="{Binding HidePreviewCommand}"
                            Content="✕" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 预览内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <Border x:Name="PreviewContentHost" Margin="12,8" />
        </ScrollViewer>
    </Grid>
</Window>
