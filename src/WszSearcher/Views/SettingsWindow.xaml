<Window x:Class="WszSearcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WszSearcher.ViewModels"
        Title="WszSearcher 设置"
        Width="560" Height="680"
        MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 分组标题样式 -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <!-- 通用按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0078D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CC3333" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20CC3333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ResourceDictionary>
</Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="WszSearcher 设置"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="配置搜索范围、外观和索引选项"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ─── 外观 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="外观" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="主题模式" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                  Width="180" Height="32" FontSize="13" />
                    </StackPanel>
                </Border>

                <!-- ─── 快捷键 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="全局快捷键" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="用于快速呼出/隐藏搜索窗口"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10" />

                        <!-- 修饰键 -->
                        <TextBlock Text="修饰键" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyCtrl}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />
                            <CheckBox Content="Alt" IsChecked="{Binding HotkeyAlt}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />
                            <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />
                            <CheckBox Content="Win" IsChecked="{Binding HotkeyWin}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- 按键选择 -->
                        <TextBlock Text="按键" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableKeys}"
                                  SelectedItem="{Binding SelectedKey}"
                                  Width="120" Height="32" FontSize="13" />

                        <!-- 预览 -->
                        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="4"
                                Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="当前快捷键：" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HotkeyPreview}" FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 测试按钮 -->
                        <Button Content="检测冲突" Margin="0,10,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Height="30" FontSize="12" Padding="12,0"
                                HorizontalAlignment="Left"
                                Command="{Binding TestHotkeyConflictCommand}" />
                    </StackPanel>
                </Border>

                <!-- ─── 索引范围 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="索引范围" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="扫描以下路径建立文件索引："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding IndexPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ObservablePath}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="2" Margin="0,0,6,0"
                                                Background="{DynamicResource BgBrush}">
                                            <TextBox Text="{Binding Path, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     Padding="6,4"
                                                     Cursor="Arrow"
                                                     TextWrapping="Wrap"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     VerticalScrollBarVisibility="Auto"
                                                     MaxHeight="72"
                                                     AcceptsReturn="False" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.RemoveIndexPathCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+ 添加路径"
                                Style="{StaticResource SecondaryButton}"
                                Height="30" FontSize="12" Padding="12,0"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding AddIndexPathCommand}" />
                    </StackPanel>
                </Border>

                <!-- ─── 排除规则 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="排除规则" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="跳过匹配以下模式的目录（逗号分隔）："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding ExcludePatternsText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- ─── 全文索引文件类型 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="全文索引文件类型" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="对以下后缀建立内容索引（逗号分隔，不含点）："
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <!-- ─── 搜索选项 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="搜索选项" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox Content="开机自动启动"
                                  IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="13" Margin="0,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="最大搜索结果数："
                                       VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBox Text="{Binding MaxResults, UpdateSourceTrigger=PropertyChanged}"
                                     Width="72" TextAlignment="Center"
                                     Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─── 索引状态 ─── -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="索引状态" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- 统计卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="4"
                                    Background="{DynamicResource BgBrush}"
                                    Padding="12,8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="文件名索引"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding FileNameCount}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="4"
                                    Background="{DynamicResource BgBrush}"
                                    Padding="12,8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="内容索引"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ContentCount}"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 进度条 -->
                        <ProgressBar Height="4"
                                     Minimum="0" Maximum="10000"
                                     Value="{Binding IndexProgress}"
                                     IsIndeterminate="{Binding IsIndexing}"
                                     Margin="0,4,0,6"
                                     Foreground="#0078D4"
                                     Background="{DynamicResource BorderBrush}" />

                        <!-- 状态文本 -->
                        <TextBlock Text="{Binding IndexStatusMessage}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" TextWrapping="Wrap" />

                        <!-- 操作按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="重建索引"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding RebuildIndexCommand}" />
                            <Button Content="刷新统计" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshIndexStatsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关于" Style="{StaticResource SecondaryButton}"
                        Click="OnAboutClick" />
                <Button Content="取消" Style="{StaticResource SecondaryButton}"
                        IsCancel="True" Click="OnCloseClick" Margin="8,0,0,0" />
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
