<Application x:Class="WszSearcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             Exit="OnAppExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 系统托盘图标 -->
            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/Resources/app.ico"
                            ToolTipText="WszSearcher - 文件搜索"
                            Visibility="Visible"
                            TrayLeftMouseUp="OnTrayLeftClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="显示窗口" Click="OnShowWindow" />
                        <MenuItem Header="设置" Click="OnOpenSettings" />
                        <Separator />
                        <MenuItem Header="关于" Click="OnShowAbout" />
                        <MenuItem Header="退出" Click="OnExitApp" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
