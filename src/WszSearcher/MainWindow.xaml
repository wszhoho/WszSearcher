<Window x:Class="WszSearcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WszSearcher.ViewModels"
        xmlns:conv="clr-namespace:WszSearcher.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="WszSearcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Width="560"
        MinWidth="480" MinHeight="48"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:SearchResultTypeToColorConverter x:Key="ResultTypeToColor" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- 主容器：圆角阴影浮层 -->
    <Grid Margin="2" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ResultRow" Height="0" />
        </Grid.RowDefinitions>

            <!-- ═══ 搜索栏 ═══ -->
            <Border x:Name="SearchBarBorder" Grid.Row="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="8"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <DockPanel LastChildFill="True">
                    <!-- 关闭按钮 -->
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Width="48" Height="48"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="22"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Click="OnCloseClick"
                            Content="✕"
                            ToolTip="关闭 (Alt+Space)" />
                    <!-- 搜索输入框（带 placeholder 提示） -->
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource SearchTextBox}" />
                        <!-- Placeholder 提示文字（搜索框为空且非搜索中时显示） -->
                        <TextBlock Text="{Binding PlaceholderText}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SearchText}" Value="" />
                                                <Condition Binding="{Binding IsSearching}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ═══ 结果区（搜索完成后展开，预览独立浮动窗口） ═══ -->
            <Grid Grid.Row="1" Margin="0,0,0,0"
                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                <!-- 初始状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSearched}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding PlaceholderText}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="12,0" />
                </StackPanel>

                <!-- 索引中 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIndexing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="正在建立索引..."
                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <ProgressBar Width="200" Height="4" IsIndeterminate="True"
                                 Foreground="#0078D4" Background="{DynamicResource BorderBrush}" />
                </StackPanel>

                <!-- 搜索中 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSearching}" Value="True" />
                                        <Condition Binding="{Binding IsIndexing}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="搜索中..."
                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <ProgressBar Width="200" Height="4" IsIndeterminate="True"
                                 Foreground="#0078D4" Background="{DynamicResource BorderBrush}" />
                </StackPanel>

                <!-- 有搜索结果时显示列表 -->
                <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 结果数量提示 -->
                    <Border Grid.Row="0" Padding="12,6" Background="{DynamicResource BgBrush}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="找到 " />
                            <Run Text="{Binding ResultCount}" FontWeight="SemiBold" />
                            <Run Text=" 个结果" />
                        </TextBlock>
                    </Border>

                    <!-- 虚拟化结果列表 -->
                    <ListBox Grid.Row="1"
                             x:Name="ResultList"
                             ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             Style="{StaticResource ResultListBox}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Standard"
                             ScrollViewer.CanContentScroll="True"
                             PreviewMouseRightButtonDown="OnResultListRightClick">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="打开文件"
                                          Command="{Binding OpenFileCommand}"
                                          CommandParameter="{Binding SelectedResult.FullPath}" />
                                <MenuItem Header="打开文件位置"
                                          Command="{Binding OpenFileLocationCommand}"
                                          CommandParameter="{Binding SelectedResult.FullPath}" />
                                <Separator />
                                <MenuItem Header="复制文件"
                                          Command="{Binding CopyFileCommand}"
                                          CommandParameter="{Binding SelectedResult.FullPath}" />
                                <MenuItem Header="复制文件名"
                                          Command="{Binding CopyFileNameCommand}"
                                          CommandParameter="{Binding SelectedResult.FullPath}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SearchResultViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="4"
                                            Background="{Binding ResultType, Converter={StaticResource ResultTypeToColor}}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Extension}"
                                                   FontSize="9" Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Directory}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding MatchSnippet}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" MaxHeight="18" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right" Margin="8,0">
                                        <TextBlock Text="{Binding FileSize}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding LastModified, StringFormat={}{0:MM/dd HH:mm}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 搜索无结果 -->
                <TextBlock Text="未搜索到任何内容"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
            </Grid>
    </Grid>
</Window>
