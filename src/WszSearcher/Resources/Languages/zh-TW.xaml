    <!-- ═══ 关于窗口 ═══ -->
    <sys:String x:Key="Lang.About.Title">關於 WszSearcher</sys:String>
    <sys:String x:Key="Lang.About.ProjectIntro">項目簡介</sys:String>
    <sys:String x:Key="Lang.About.Description">基於 USN Journal + Lucene.NET，實現毫秒級文件名和內容檢索。jieba 中文分詞、拼音首字母/全拼輔助模糊匹配。支持多盤多目錄索引、自定義全局快捷鍵、浮動文件預覽、系統托盤駐留。便攜綠色版，不寫入系統目錄。</sys:String>
    <sys:String x:Key="Lang.About.TechStack">技術棧</sys:String>
    <sys:String x:Key="Lang.About.TechDesktop">桌面應用框架</sys:String>
    <sys:String x:Key="Lang.About.TechUsn">NTFS MFT 毫秒級掃描</sys:String>
    <sys:String x:Key="Lang.About.TechLucene">全文檢索引擎</sys:String>
    <sys:String x:Key="Lang.About.TechJieba">中文分詞</sys:String>
    <sys:String x:Key="Lang.About.TechPinyin">拼音首字母模糊搜索</sys:String>
    <sys:String x:Key="Lang.About.TechPdf">PDF 文檔解析</sys:String>
    <sys:String x:Key="Lang.About.TechOffice">Office 文檔解析</sys:String>
    <sys:String x:Key="Lang.About.TechTray">系統托盤駐留</sys:String>
    <sys:String x:Key="Lang.About.TechMvvm">MVVM 架構</sys:String>
