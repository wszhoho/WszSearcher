    <!-- ═══ 关于窗口 ═══ -->
    <sys:String x:Key="Lang.About.Title">关于 WszSearcher</sys:String>
    <sys:String x:Key="Lang.About.ProjectIntro">项目简介</sys:String>
    <sys:String x:Key="Lang.About.Description">基于 USN Journal + Lucene.NET，实现毫秒级文件名和内容检索。jieba 中文分词、拼音首字母/全拼辅助模糊匹配。支持多盘多目录索引、自定义全局快捷键、浮动文件预览、系统托盘驻留。便携绿色版，不写入系统目录。</sys:String>
    <sys:String x:Key="Lang.About.TechStack">技术栈</sys:String>
    <sys:String x:Key="Lang.About.TechDesktop">桌面应用框架</sys:String>
    <sys:String x:Key="Lang.About.TechUsn">NTFS MFT 毫秒级扫描</sys:String>
    <sys:String x:Key="Lang.About.TechLucene">全文检索引擎</sys:String>
    <sys:String x:Key="Lang.About.TechJieba">中文分词</sys:String>
    <sys:String x:Key="Lang.About.TechPinyin">拼音首字母模糊搜索</sys:String>
    <sys:String x:Key="Lang.About.TechPdf">PDF 文档解析</sys:String>
    <sys:String x:Key="Lang.About.TechOffice">Office 文档解析</sys:String>
    <sys:String x:Key="Lang.About.TechTray">系统托盘驻留</sys:String>
    <sys:String x:Key="Lang.About.TechMvvm">MVVM 架构</sys:String>
    <sys:String x:Key="Lang.About.License">许可</sys:String>
