    <!-- ═══ About Window ═══ -->
    <sys:String x:Key="Lang.About.Title">About WszSearcher</sys:String>
    <sys:String x:Key="Lang.About.ProjectIntro">Project Description</sys:String>
    <sys:String x:Key="Lang.About.Description">Built on USN Journal + Lucene.NET for millisecond-level file name and content search. jieba Chinese word segmentation and pinyin initials/full spelling fuzzy matching. Supports multi-drive and multi-directory indexing, customizable global hotkey, floating file preview and system tray residency. Portable green edition; writes nothing to system directories.</sys:String>
    <sys:String x:Key="Lang.About.TechStack">Tech Stack</sys:String>
    <sys:String x:Key="Lang.About.TechDesktop">Desktop application framework</sys:String>
    <sys:String x:Key="Lang.About.TechUsn">Millisecond NTFS MFT scanning</sys:String>
    <sys:String x:Key="Lang.About.TechLucene">Full-text search engine</sys:String>
    <sys:String x:Key="Lang.About.TechJieba">Chinese word segmentation</sys:String>
    <sys:String x:Key="Lang.About.TechPinyin">Pinyin initials fuzzy search</sys:String>
    <sys:String x:Key="Lang.About.TechPdf">PDF document parsing</sys:String>
    <sys:String x:Key="Lang.About.TechOffice">Office document parsing</sys:String>
    <sys:String x:Key="Lang.About.TechTray">System tray residency</sys:String>
    <sys:String x:Key="Lang.About.TechMvvm">MVVM architecture</sys:String>
    <sys:String x:Key="Lang.About.License">License</sys:String>
    <sys:String x:Key="Lang.About.LicenseText">© 2026 wszhoho. MIT License. This software is provided "as is" without warranty of any kind, express or implied.</sys:String>
    <sys:String x:Key="Lang.About.OK">OK</sys:String>

